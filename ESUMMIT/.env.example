# Copy to .env.local and fill in.

# Backend API (E_Summit_Backend)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Demo payments: skips Razorpay checkout.js entirely and verifies a synthesized
# transaction. The backend accepts it because RAZORPAY_KEY_SECRET is unset there.
# Set to false + add real Razorpay keys to the backend .env to go live.
NEXT_PUBLIC_DEMO_PAYMENTS=true

# next-auth — generate the secret with: openssl rand -hex 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_openssl_rand_hex_32

# Server-side only — never commit real keys
GROQ_API_KEY=your_groq_api_key_here

# Deprecated: remove NEXT_PUBLIC_GROQ_API_KEY if present (key must stay server-side)
