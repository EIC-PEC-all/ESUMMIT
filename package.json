{
  "name": "e-summit-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:all": "npx -y concurrently -n \"FRONTEND,BACKEND,ADMIN,RESPONSES\" -c \"green,blue,magenta,cyan\" \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:admin\" \"npm run dev:responses\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:admin": "npm --prefix admin run dev -- -p 3001",
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:responses": "npm --prefix response-manager run dev",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:admin": "npm --prefix admin run build",
    "build:backend": "npm --prefix backend run build",
    "build:responses": "npm --prefix response-manager run build",
    "typecheck": "npm --prefix frontend run typecheck",
    "lint": "npm --prefix frontend run lint",
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down"
  },
  "devDependencies": {
    "mongodb": "^7.7.0"
  }
}
