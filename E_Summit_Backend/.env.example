# ─────────────────────────────────────────────────────────────
# E_Summit_Backend — environment configuration
# Copy to `.env` and fill in. Never commit the real `.env`.
# ─────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed to send credentialed requests.
# ESUMMIT public site + esummit-admin portal.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Database (matches docker-compose.yml) ────────────────────
DATABASE_URL=postgresql://esummit:esummit_dev_password@localhost:5433/esummit?schema=public

# ── Redis (rate limiting, sessions, BullMQ) ──────────────────
REDIS_URL=redis://localhost:6380

# ── Auth / JWT (§4.1) ────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Cookie domain for the HTTP-only refresh token. Leave blank for localhost.
AUTH_COOKIE_DOMAIN=

# ── QR / Gate check-in (§5.1) ────────────────────────────────
# HMAC-SHA256 signing key for pass QR tokens. Rotating this invalidates
# every issued badge — do not change mid-event.
QR_HMAC_SECRET=replace_me_with_a_long_random_string

# ── Razorpay (§4.3) ──────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Google OAuth (§4.1) ──────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI Concierge (§4.6) ──────────────────────────────────────
GEMINI_API_KEY=

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM="PEC Summit <noreply@ecellpec.in>"

# ── AWS S3 (badges, pitch decks) ─────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
